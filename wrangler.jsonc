{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wpsimagecompat",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/version.json"],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
